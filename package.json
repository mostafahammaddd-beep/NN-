{
  "name": "nclex-rn",
  "version": "3.19.0",
  "private": true,
  "type": "module",
  "description": "NCLEX-RN study app (Android via Capacitor, Windows via Electron)",
  "author": "NCLEX-RN",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@fontsource/cairo": "^5.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.nclexrn.desktop",
    "productName": "NCLEX-RN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon-only.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon-only.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "NCLEX-RN-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NCLEX-RN-Portable-${version}.${ext}"
    }
  }
}
